# TradeLab AI — copy to .env and fill locally. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://tradelab:tradelab@localhost:5432/tradelab
DATA_ROOT=./data
DEMO_MODE=true

# DeepSeek (OpenAI-compatible Chat Completions)
# Get a key at https://platform.deepseek.com/
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Prefer flash for research synthesis over tool evidence; use deepseek-v4-pro for harder reasoning.
LLM_MODEL=deepseek-v4-flash
# Set to false only if corporate proxy breaks SSL verification (dev only)
LLM_SSL_VERIFY=true

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Broker connectors run only on a local machine — leave empty in demo/cloud.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=71
